+set(RECOMP_GEN_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../sp00nznet-run/gen_v2" CACHE PATH "Generated recomp output")
+file(GLOB RECOMP_GEN_SOURCES CONFIGURE_DEPENDS "${RECOMP_GEN_DIR}/*.c")
 
